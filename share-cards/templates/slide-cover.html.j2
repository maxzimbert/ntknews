{# Carousel 1 — cover. 1080x1350 (4:5). Always included.
   Ink ground, duotone photo, cream story card overlapping it (the site hero). #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block css %}
.card { background: var(--ink); }
.top { position: absolute; left: 72px; right: 72px; top: 64px; display: flex; justify-content: space-between; align-items: center; }
.plabel { position: absolute; left: 104px; top: 196px; font-family: var(--sans); font-weight: 500; font-size: 22px; color: rgba(255,255,255,0.95); }
.sc { position: absolute; left: 72px; top: 690px; width: 830px; background: var(--cream); border-radius: var(--radius); padding: 40px 48px 38px; box-shadow: 0 26px 60px rgba(0,0,0,0.35); }
.sc .eb { font-family: var(--sans); font-size: 24px; color: var(--coral-deep); }
.sc .hl { margin-top: 14px; font-family: var(--serif); font-weight: 400; letter-spacing: -0.012em; line-height: 1.14; color: var(--ink); max-height: 340px; overflow: hidden; }
.sc .go { margin-top: 26px; display: flex; align-items: center; gap: 14px; font-size: 25px; color: var(--ink); }
{% endblock %}
{% block body %}
<div class="top">{{ m.logo('white', 56) }}{{ m.counter('var(--cream-72)') }}</div>
{{ m.duo(story.photo, 'position:absolute; left:72px; top:164px; width:936px; height:640px; border-radius:3px') }}
<div class="plabel">{{ story.category }}<span class="sep">·</span>{{ story.date_label }}</div>
<div class="sc">
  <div class="eb">{{ story.subject or story.category }}</div>
  <div class="hl" data-fit="60,38">{{ story.headline }}</div>
  <div class="go url">Swipe for what's true {{ m.arrow('#261F23', 28) }}</div>
</div>
{% endblock %}
