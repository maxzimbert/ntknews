{# Pinterest pin — 1000x1500 (2:3). Passed as media= in the Pinterest intent,
   so it is the one platform where the reader's share carries our image AND a
   live link. Photo on top, story card overlapping, two Truths underneath. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block css %}
.card { background: var(--cream); }
.sc { position: absolute; left: 56px; right: 56px; top: 560px; bottom: 56px; background: var(--cream-raised); border-radius: var(--radius); padding: 44px 48px 40px; display: flex; flex-direction: column; box-shadow: 0 22px 50px rgba(38,31,35,0.22); }
.eb { font-family: var(--sans); font-size: 24px; color: var(--coral-deep); }
.hl { margin-top: 14px; max-height: 300px; overflow: hidden; line-height: 1.06; color: var(--ink); }
.lbl { margin-top: 34px; font-size: 30px; color: var(--ink-60); }
.items { margin-top: 14px; flex: 1 1 auto; min-height: 0; overflow: hidden; display: flex; flex-direction: column; gap: 0.8em; }
.it { border-left: var(--rule-truths); padding-left: 0.7em; font-family: var(--serif); font-weight: 400; line-height: 1.3; color: var(--ink); }
.foot { margin-top: 28px; display: flex; justify-content: space-between; align-items: center; }
.addr { font-size: 26px; color: var(--ink); display: flex; align-items: center; gap: 12px; }
{% endblock %}
{% block body %}
{{ m.duo(story.photo, 'position:absolute; left:0; top:0; width:1000px; height:700px') }}
{{ m.logo('white', 60, 'position:absolute; left:56px; top:52px') }}
<div class="sc">
  <div class="eb">{{ story.category }}<span class="sep">·</span>{{ story.date_label }}</div>
  <div class="hl headline" data-fit="54,38">{{ story.headline }}</div>
  <div class="lbl smallcaps">What's true</div>
  <div class="items" data-fit="34,22">
    {% for t in story.truths[:2] %}<div class="it">{{ t }}</div>{% endfor %}
  </div>
  <div class="foot">{{ m.logo('ink', 48) }}<div class="addr url">{{ story.short_url }} {{ m.arrow('#261F23', 28) }}</div></div>
</div>
{% endblock %}
