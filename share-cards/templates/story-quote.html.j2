{# Story variant when the story carries a verified quote — 1080x1920.
   Deep-blue ground (the site's image-panel color), cream card with the
   duotone photo cropped wide on top, the quote in Newsreader italic, and the
   headline underneath for context. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% set q = story.quote %}
{% block css %}
.card { background: var(--blue-deep); }
.top { position: absolute; left: 80px; right: 80px; top: 96px; display: flex; justify-content: space-between; align-items: center; }
.eyebrow { color: var(--cream); font-size: 24px; }
.flow { position: absolute; left: 80px; right: 80px; top: 240px; display: flex; flex-direction: column; gap: 72px; }
.qc { background: var(--cream-raised); border-radius: var(--radius); overflow: hidden; box-shadow: 0 30px 70px rgba(0,0,0,0.3); }
.qb { padding: 40px 56px 48px; }
.mark { font-family: var(--serif); font-weight: 600; font-size: 180px; line-height: 0.75; height: 92px; color: var(--amber); }
.qt { font-family: var(--serif); font-style: italic; font-weight: 400; line-height: 1.2; letter-spacing: -0.01em; color: var(--ink); max-height: 520px; overflow: hidden; }
.who { margin-top: 36px; display: flex; gap: 22px; align-items: flex-start; }
.who .rule { width: 6px; align-self: stretch; background: var(--ink); }
.who .nm { font-family: var(--sans); font-weight: 700; font-size: 30px; color: var(--ink); }
.who .rl { margin-top: 6px; font-family: var(--serif); font-style: italic; font-size: 28px; color: var(--ink-72); }
.ctx { margin-top: 40px; padding-top: 32px; border-top: 1px solid rgba(38,31,35,0.16); }
.ctx .hl { font-family: var(--serif); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; color: var(--ink); max-height: 150px; overflow: hidden; }
.ctx .go { margin-top: 22px; display: flex; align-items: center; gap: 14px; font-size: 26px; color: var(--ink); }
{% endblock %}
{% block body %}
<div class="top">
  {{ m.logo('white', 66) }}
  <div class="eyebrow kicker">{{ story.category }}<span class="sep">·</span>{{ story.date_label }}</div>
</div>
<div class="flow">
<div class="qc">
  {{ m.duo(story.photo, 'width:100%; height:440px') }}
  <div class="qb">
    <div class="mark" aria-hidden="true">“</div>
    <div class="qt" data-fit="58,40">{{ q.text }}</div>
    <div class="who"><div class="rule"></div><div><div class="nm">{{ q.speaker }}</div><div class="rl">{{ q.role }}<span class="sep">·</span>via {{ q.source }}</div></div></div>
    <div class="ctx">
      <div class="hl" data-fit="34,26">{{ story.headline }}</div>
      <div class="go url">Read it at {{ story.short_url }} {{ m.arrow('#261F23', 28) }}</div>
    </div>
  </div>
</div>
{{ m.brandline(72, 'var(--cream)', 'var(--amber)') }}
</div>
{% endblock %}
