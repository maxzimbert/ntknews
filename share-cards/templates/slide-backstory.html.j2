{# Carousel — Backstory pairing + "We are here". Only when the story has an
   approved Backstory pairing. Replaces the old day-count clock. The timeline
   is the site's Backstory module: years, ink dots on a hairline, ending in the
   coral "Today" ring marked "You came in here". Last three milestones max. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% set bs = story.backstory %}
{% block css %}
.card { background: var(--cream-raised); }
.top { position: absolute; left: 72px; right: 72px; top: 64px; display: flex; justify-content: space-between; align-items: center; }
.kick { color: var(--ink-67); font-size: 20px; }
.title { position: absolute; left: 72px; right: 72px; top: 132px; max-height: 150px; overflow: hidden; color: var(--ink); line-height: 1.02; }
.pair { position: absolute; left: 72px; right: 72px; top: 300px; height: 170px; overflow: hidden; font-family: var(--serif); font-weight: 400; line-height: 1.3; color: var(--ink-78); }
.tl { position: absolute; left: 72px; right: 72px; top: 520px; height: 560px; overflow: hidden; }
.row { display: grid; grid-template-columns: 4.2em 2em 1fr; position: relative; padding-bottom: 1.1em; }
.row::before { content: ""; position: absolute; left: calc(4.2em + 1em - 1px); top: 0.6em; bottom: -0.6em; width: 2px; background: rgba(38,31,35,0.25); }
.row:last-child::before { display: none; }
.yr { font-family: var(--sans); font-weight: 700; font-size: 0.85em; padding-top: 0.15em; color: var(--ink); }
.dt { justify-self: center; width: 0.55em; height: 0.55em; border-radius: 999px; background: var(--ink); margin-top: 0.4em; position: relative; z-index: 1; }
.tx { font-family: var(--serif); font-weight: 400; line-height: 1.3; color: var(--ink); }
.today .yr { color: var(--coral); }
.ring { justify-self: center; width: 0.85em; height: 0.85em; border-radius: 999px; border: 3px solid var(--coral); background: var(--cream-raised); display: flex; align-items: center; justify-content: center; margin-top: 0.25em; position: relative; z-index: 1; }
.ring i { width: 0.3em; height: 0.3em; border-radius: 999px; background: var(--coral); }
.here { font-family: var(--sans); font-weight: 700; font-size: 0.62em; letter-spacing: 0.1em; text-transform: uppercase; color: var(--coral); margin-bottom: 0.2em; }
.foot { position: absolute; left: 72px; right: 72px; bottom: 64px; display: flex; justify-content: space-between; align-items: center; }
.btn { background: var(--amber); color: var(--ink); border-radius: var(--radius); padding: 22px 30px 18px; display: flex; align-items: center; gap: 16px; font-size: 30px; }
.addr { font-size: 22px; color: var(--ink-67); text-align: right; }
{% endblock %}
{% block body %}
<div class="top"><div class="kick kicker">Backstory</div>{{ m.counter('var(--ink-67)') }}</div>
<div class="title headline" data-fit="64,44">{{ bs.title }}</div>
<div class="pair" data-fit="38,28">{{ bs.pairing_line }}</div>
<div class="tl" data-fit="30,22">
  {% for x in bs.milestones[-3:] %}
  <div class="row"><div class="yr">{{ x.year }}</div><div class="dt"></div><div class="tx">{{ x.line }}</div></div>
  {% endfor %}
  <div class="row today"><div class="yr">Today</div><div class="ring"><i></i></div><div><div class="here">You came in here</div><div class="tx">{{ bs.today_line }}</div></div></div>
</div>
<div class="foot">
  <div class="btn url">We are here {{ m.arrow('#261F23', 30) }}</div>
  <div class="addr url">{{ bs.short_url }}</div>
</div>
{% endblock %}
