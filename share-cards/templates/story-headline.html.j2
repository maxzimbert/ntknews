{# Reader share to Instagram / Facebook Stories — 1080x1920.
   The site hero, stood upright: duotone photo with the cream story card
   overlapping it, the brand line underneath. The bottom ~320px stays clear
   for an optional link sticker; the short address on the card does the
   linking when the reader adds nothing. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block css %}
.card { background: var(--ink); }
.top { position: absolute; left: 80px; right: 80px; top: 96px; display: flex; justify-content: space-between; align-items: center; }
.eyebrow { display: flex; align-items: center; gap: 14px; color: var(--amber); font-size: 24px; }
.photo-label { position: absolute; left: 236px; top: 270px; font-family: var(--sans); font-weight: 500; font-size: 24px; color: rgba(255,255,255,0.95); }
.flow { position: absolute; left: 80px; top: 900px; width: 920px; display: flex; flex-direction: column; gap: 72px; }
.sc { width: 800px; background: var(--cream); border-radius: var(--radius); padding: 46px 52px 44px; box-shadow: 0 30px 70px rgba(0,0,0,0.35); }
.sc .eb { font-family: var(--sans); font-size: 26px; color: var(--coral-deep); }
.sc .hl { margin-top: 18px; font-family: var(--serif); font-weight: 400; letter-spacing: -0.012em; line-height: 1.14; color: var(--ink); max-height: 420px; overflow: hidden; }
.sc .go { margin-top: 30px; display: flex; align-items: center; gap: 14px; font-size: 28px; color: var(--ink); }
{% endblock %}
{% block body %}
<div class="top">
  {{ m.logo('white', 66) }}
  <div class="eyebrow kicker">{{ m.dot('var(--amber)', 12) }}<span>{{ story.date_label }}</span></div>
</div>
{{ m.duo(story.photo, 'position:absolute; left:200px; top:230px; width:800px; height:880px; border-radius:3px') }}
<div class="photo-label">{{ story.category }}</div>
<div class="flow">
  <div class="sc">
    <div class="eb">{{ story.subject or story.category }}</div>
    <div class="hl" data-fit="58,42">{{ story.headline }}</div>
    <div class="go url">Read it at {{ story.short_url }} {{ m.arrow('#261F23', 30) }}</div>
  </div>
  {{ m.brandline(72, 'var(--cream)', 'var(--amber)') }}
</div>
{% endblock %}
