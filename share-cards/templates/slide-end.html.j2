{# Carousel — end card. Always last. The site's amber closing section:
   brand line in ink with an ink italic accent, the hero copy, ink button. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block css %}
.card { background: var(--amber); }
.top { position: absolute; left: 72px; right: 72px; top: 64px; display: flex; justify-content: space-between; align-items: center; }
.mid { position: absolute; left: 72px; right: 72px; top: 250px; display: flex; flex-direction: column; gap: 44px; }
.copy { font-family: var(--serif); font-weight: 400; font-size: 38px; line-height: 1.35; color: var(--ink); max-width: 820px; }
.copy b { font-weight: 600; }
.cta { display: flex; align-items: center; gap: 28px; margin-top: 10px; }
.btn { background: var(--ink); color: var(--cream); border-radius: var(--radius); padding: 26px 38px 22px; font-size: 32px; }
.note { font-family: var(--sans); font-weight: 500; font-size: 22px; color: var(--ink-78); }
.foot { position: absolute; left: 72px; right: 72px; bottom: 64px; display: flex; justify-content: space-between; align-items: flex-end; }
.addr { font-size: 30px; color: var(--ink); }
{% endblock %}
{% block body %}
<div class="top"><div class="kicker" style="font-size: 20px; color: var(--ink-78)">Today's NTK</div>{{ m.counter('var(--ink-78)') }}</div>
<div class="mid">
  {{ m.brandline(118, 'var(--ink)', 'var(--ink)', true) }}
  <div class="copy">What happened, why, and what's next. Three minutes, with backstory when you want. <b>The antidote to information overload.</b></div>
  <div class="cta"><div class="btn url">Read today's NTK</div><div class="note">Free. No sign-up. No endless feed.</div></div>
</div>
<div class="foot">{{ m.logo('ink', 96) }}<div class="addr url">ntknews.org</div></div>
{% endblock %}
